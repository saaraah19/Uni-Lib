# Copy to frontend/.env. Values prefixed REACT_APP_ are baked into the bundle at BUILD time.

# LOCAL DEVELOPMENT ONLY — base URL of the API, including the /api suffix.
# In a production build this can be left unset: the app then calls the API on its own
# origin (/api), which is how the single Render service works.
REACT_APP_API_URL=http://localhost:5000/api
