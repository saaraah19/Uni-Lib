# Copy to backend/.env and fill in. NEVER commit the real .env file.

# MongoDB Atlas connection string (Atlas → Connect → Drivers). The database name is part of the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/librairie_universitaire?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=change-me

# Exact origin of the frontend (CORS). No trailing slash.
CLIENT_URL=http://localhost:3000

PORT=5000
NODE_ENV=development
